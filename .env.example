# VSMS 環境變數範例。複製為 .env 後填入實際值。
# .env 已在 .gitignore 中，不會進版控。

# ── 基本 ──────────────────────────────────────────────
PORT=3001
SESSION_SECRET=change-this-in-production
NODE_ENV=production
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/vsms"

# ── HTTPS ─────────────────────────────────────────────
# 兩個都設定時走 HTTPS，否則退回 HTTP。
# 正式站必須走 HTTPS：VTMS 對同一台主機送出 HSTS，而 HSTS 以主機為範圍、
# 不分連接埠，瀏覽器只要開過 VTMS，之後連 http://<host>:3001 都會被改寫成
# https 而連不上。
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=

# ── 對外整合 ──────────────────────────────────────────
# /api/integration/* 的 API 金鑰（Copilot agent 經 MCP 使用）
INTEGRATION_API_KEY=
# VTMS 測試計畫進度查詢
VTMS_API_URL=
VTMS_API_KEY=

# ── 排程啟動前預告通知 ────────────────────────────────
# 寄信已移到平台（vauth）：SMTP 設定與寄送邏輯都在那邊，VSMS 只保留範本、
# 預覽與寄信規則，改呼叫 NOTIFY_URL 的投遞 API。
#
# NOTIFY_URL 未設定時，通知功能會停用並在啟動時印出警告，不影響系統其他
# 功能。VAUTH_SERVICE_KEY 見下方單一登入區塊，同一把金鑰共用。
NOTIFY_URL=http://127.0.0.1:4100

# 單一登入：vauth 才啟用 SSO 認領。預設 local＝現況不變。
AUTH_PROVIDER=local
VAUTH_URL=http://127.0.0.1:4100
VAUTH_SERVICE_KEY=
# 組織同步端點 /api/internal/org-sync 的專用金鑰（與 vportal/.env 的 ORG_SYNC_API_KEY 同一把；與 INTEGRATION_API_KEY 分開）。
ORG_SYNC_API_KEY=
# 啟動時向 vauth 拉組織快照用（與 vportal/.env 的 VAUTH_SERVICE_KEY 同一把）。留空就不拉。
