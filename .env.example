# VSMS 環境變數範例。複製為 .env 後填入實際值。
# .env 已在 .gitignore 中，不會進版控。

# ── 基本 ──────────────────────────────────────────────
PORT=3001
SESSION_SECRET=change-this-in-production
NODE_ENV=production
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/vsms"

# ── HTTPS ─────────────────────────────────────────────
# 兩個都設定時走 HTTPS，否則退回 HTTP。
# 正式站必須走 HTTPS：VTMS 對同一台主機送出 HSTS，而 HSTS 以主機為範圍、
# 不分連接埠，瀏覽器只要開過 VTMS，之後連 http://<host>:3001 都會被改寫成
# https 而連不上。
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=

# ── 對外整合 ──────────────────────────────────────────
# /api/integration/* 的 API 金鑰（Copilot agent 經 MCP 使用）
INTEGRATION_API_KEY=
# VTMS 測試計畫進度查詢
VTMS_API_URL=
VTMS_API_KEY=

# ── 排程啟動前預告通知（SMTP）─────────────────────────
# SMTP_HOST 或 SMTP_FROM 未設定時，通知功能會停用並在啟動時印出警告，
# 不影響系統其他功能。
#
# SMTP_PORT 未設定或留空時視為 25；填了非數字或超出 1-65535 會在啟動時
# 以明確訊息擋下，不會靜默連到錯的地方。
#
# SMTP_SECURE 只有走 implicit TLS（通常是 port 465）才設 true。
# port 25 / 587 的 STARTTLS 維持 false。
#
# SMTP_USER / SMTP_PASS 留空即以匿名轉發連線 —— 多數公司內部 relay
# 對內網 IP 都允許，先確認再決定要不要填。
#
# 注意：這幾個值在程序啟動時讀取並快取整個生命週期，改完必須重啟服務。
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASS=
